#!/bin/zsh

set -euo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

push_updates=$(cat)
[[ -n "$push_updates" ]] || exit 0

remote_oid=""
while read -r local_ref local_oid remote_ref zero_oid; do
    if [[ "$local_ref" != "(delete)" || -n "${local_oid//0/}" ]]; then
        remote_oid="$zero_oid"
        break
    fi
done <<< "$push_updates"

[[ -n "$remote_oid" ]] || exit 0

if [[ "$remote_oid" == 0000000000000000000000000000000000000000 ]]; then
    base=$(git rev-list --max-parents=0 HEAD | tail -1)
else
    base="$remote_oid"
fi

changed=$(git diff --name-only "$base" HEAD 2>/dev/null || true)
[[ -n "$changed" ]] || exit 0

needs_check=0
while read -r path; do
    [[ -n "$path" ]] || continue
    case "$path" in
        Scripts/rules/*|Scripts/console/*|Config/*|Regression/*|.githooks/*|.swiftlint.yml)
            needs_check=1
            ;;
        *.swift|*.m|*.h|*.py|*.sh|Package.swift|*.xcodeproj/*)
            needs_check=1
            ;;
    esac
    (( needs_check )) && break
done <<< "$changed"

(( needs_check )) || exit 0

(
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX \
      GIT_QUARANTINE_PATH

python3 "$repository_root/Scripts/console/cli.py" plan check
python3 "$repository_root/Scripts/console/cli.py" tier static --quick
)

git lfs pre-push "$@" <<< "$push_updates"
