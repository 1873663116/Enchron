#!/bin/zsh

set -euo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

push_updates=$(cat)
[[ -n "$push_updates" ]] || exit 0

local_oids=()
remote_oids=()
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ -n "$local_ref" ]] || continue
    [[ "$local_ref" == "(delete)" ]] && continue
    local_oids+=("$local_oid")
    remote_oids+=("$remote_oid")
done <<< "$push_updates"

empty_list=$(mktemp "${TMPDIR:-/tmp}/enchron-changed.XXXXXX")
trap 'rm -f "$empty_list"' EXIT

(
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX \
      GIT_QUARANTINE_PATH

eval "$(bash "$repository_root/Scripts/ci/prepare.sh" shell --emit)"
python3 "$repository_root/Scripts/console/cli.py" plan check
if (( ${#local_oids} == 0 )); then
    python3 "$repository_root/Scripts/console/cli.py" tier static --changed-list "$empty_list"
else
    index=1
    while (( index <= ${#local_oids} )); do
        python3 "$repository_root/Scripts/console/cli.py" tier static \
            --event push \
            --remote-oid "${remote_oids[$index]}" \
            --local-oid "${local_oids[$index]}"
        (( index++ ))
    done
fi
)

git lfs pre-push "$@" <<< "$push_updates"
