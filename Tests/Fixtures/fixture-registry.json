  "deviceMediaRoot": "$HOME/Desktop/TestMedia",
  "acceptanceCriteriaDefinitions": {
    "continuousPlayback": {
      "minimumObservationSeparationSeconds": 1.0,
      "minimumMediaTimeAdvanceSeconds": 0.25,
      "requiredStableFields": ["mediaSession", "streamEpoch"],
      "requiredAdvancingFields": ["mediaTime", "videoSamples", "rendererAcceptedInputs"],
      "requiredTrueFields": ["displayedPixel"],
      "audioRequirement": "When the selected media has audio, audio samples and audio renderer samples also advance, the audio renderer reports rendering without error, and the system audio session and output route are active."
    },
    "videoOnlyPlayback": {
      "requiredResult": "Video satisfies continuousPlayback without creating a failed or placeholder audio path, and the Audio Track menu is absent."
    },
    "audioVideoSynchronization": {
      "sourceMarkers": "An 80 ms white flash and a same-period audio pulse begin at every whole media second.",
      "referenceStandard": "EBU Recommendation R37-2007",
      "referenceURL": "https://tech.ebu.ch/docs/r/r037.pdf",
      "maximumSoundBeforePictureMilliseconds": 40,
      "maximumSoundAfterPictureMilliseconds": 60,
      "decisionRule": "Pass only when the complete 95 percent confidence interval for measured sound-to-picture offset lies inside both limits. A confidence interval that crosses either limit is inconclusive and requires another calibrated capture."
    },
    "audioTrackSelection": {
      "requiredResult": "Every registered track is selectable by its stable identity; selecting it keeps the Media Session, Playback Presentation and media position, stops output from the previous track, and produces the selected track's registered pulse frequency."
    },
    "embeddedSubtitleSelection": {
      "requiredResult": "Every registered subtitle track and Off are selectable without opening another Media Session; cue text or bitmap content follows the current stream epoch and media time in Window, Docked and Panorama."
    },
    "externalSubtitleSelection": {
      "requiredResult": "Matching subtitle files appear as distinct tracks in the current Media Session without automatically selecting one of multiple candidates. Selecting a track preserves the Media Session, Playback Lifecycle, Playback Presentation, media time and audio/video output; Off clears its cue, and Close releases its source access."
    },
    "hdrMetadataAndDisplay": {
      "requiredResult": "Compressed sample metadata and the displayed pixel metadata match the registered primaries, transfer function, matrix and range. Device HDR or EDR appearance remains a separate wearer-visible acceptance result."
    }
  },
