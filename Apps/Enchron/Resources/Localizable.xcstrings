        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 창에서 미디어 파일을 재생 중입니다. 재생을 끝낸 후 스트리밍을 시작하십시오"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
