          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像に合うディスプレイモードをシステムに要求します。オフにするとシステムのデフォルトと比較できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상에 맞는 디스플레이 모드를 시스템에 요청해요. 끄면 시스템 기본값과 비교할 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает режим дисплея, соответствующий видео. Отключите, чтобы сравнить с системными настройками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
