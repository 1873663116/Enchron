    "Darken the room around the player window and around environments that request it, without touching the video.": {
      "comment": "Apps/Enchron/Screens/SettingsScreen.swift:359",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdunkelt den Raum um das Wiedergabefenster und um Umgebungen, die dies anfordern – das Video selbst bleibt unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit la pièce autour de la fenêtre de lecture et autour des environnements qui le demandent, sans toucher à la vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイヤーウィンドウの周囲と、調光を求める環境の周囲を暗くします。映像自体は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이어 윈도우 주변과 어둡기를 요청하는 환경 주변을 어둡게 해요. 영상 자체는 그대로 유지돼요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет комнату вокруг окна проигрывателя и вокруг сред, которые этого требуют, не изменяя само видео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调暗播放器窗口周围与请求调暗的环境，不改变视频画面本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調暗播放器視窗周圍與要求調暗的環境，不更動影片畫面本身。"
          }
        }
      }
    },
