{
  "sourceLanguage": "en",
  "strings": {
    "\"Open water under a slow sky, the screen mirrored in the swell.\"": {
      "comment": "Modules/Playback/Views/EnvironmentComponents.swift:38",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Offenes Wasser unter langsamem Himmel, der Bildschirm spiegelt sich in der Dünung.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Eau libre sous un ciel lent, l'écran se reflète dans la houle. »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ゆったりとした空の下に広がる外洋、うねりに映り込む画面。」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“느린 하늘 아래 열린 물, 넘실에 비친 화면.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Открытая вода под неспешным небом, экран отражается в зыби.»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“舒缓天光下的开阔水域，屏幕倒映在涌浪之中。”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「緩慢天色下的開闊水域，螢幕倒映在湧浪之中。」"
          }
        }
      }
    },
    "%@ is outside your local network, so requests to its http:// address travel over the public internet. Your username and password are sent unencrypted, and any device on the path can read them. Use https:// or a private encrypted network instead.": {
      "comment": "Apps/Enchron/ConnectionSecurityPrompt.swift:35",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt außerhalb deines lokalen Netzwerks. Anfragen an seine http://-Adresse laufen über das öffentliche Internet. Benutzername und Passwort werden unverschlüsselt übertragen, und jedes Gerät auf dem Weg kann sie lesen. Verwende stattdessen https:// oder ein privat verschlüsseltes Netzwerk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se trouve en dehors de votre réseau local. Les requêtes vers son adresse http:// transitent donc par Internet public. Votre nom d'utilisateur et votre mot de passe sont envoyés sans chiffrement, et tout appareil sur le chemin peut les lire. Utilisez plutôt https:// ou un réseau privé chiffré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はローカルネットワークの外にあるため、その http:// アドレスへのリクエストは公衆インターネットを経由します。ユーザー名とパスワードは暗号化されずに送信され、経路上のあらゆるデバイスがそれらを読み取ることができます。代わりに https:// または暗号化されたプライベートネットワークを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 로컬 네트워크 밖에 있어 http:// 주소로 보내는 요청은 공용 인터넷을 통과해요. 사용자 이름과 비밀번호가 암호화되지 않은 채 전송되어 경로상의 어떤 기기든 읽을 수 있어요. 대신 https:// 또는 암호화된 사설 네트워크를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ находится вне вашей локальной сети, поэтому запросы к его адресу http:// идут через публичный интернет. Имя пользователя и пароль передаются без шифрования, и любое устройство на пути между вами и сервером может их прочитать. Используйте https:// или частную зашифрованную сеть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在你的本地网络内，对其 http:// 地址的请求会经由公共互联网传输。你的用户名和密码将以未加密方式发送，路径上的任何设备都可能读取到它们。请改用 https:// 或私有加密网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在您的區域網路內，因此對其 http:// 位址的請求會經由公開網際網路傳送。您的使用者名稱與密碼將以未加密的方式送出，傳輸路徑上的任何裝置都能讀取這些資訊。請改用 https:// 或私有的加密網路。"
          }
        }
      }
    },
