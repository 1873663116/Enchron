    "网络不稳：画面与操作可能延迟": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerk instabil: Bild und Eingabe können verzögert sein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réseau instable : l'image et les commandes peuvent être retardées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク不安定：映像と操作に遅延が生じる可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
