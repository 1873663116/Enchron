          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 쪽 페어링 화면에서 이 PIN을 입력하고 확인하십시오(예: Sunshine의 웹 UI)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
