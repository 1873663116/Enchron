[binaries]
c = ['/usr/bin/xcrun', '--sdk', 'xros', 'clang']
cpp = ['/usr/bin/xcrun', '--sdk', 'xros', 'clang++']
ar = ['/usr/bin/xcrun', '--sdk', 'xros', 'ar']
strip = ['/usr/bin/xcrun', '--sdk', 'xros', 'strip']
pkgconfig = '/usr/bin/pkg-config'

[host_machine]
system = 'darwin'
cpu_family = 'aarch64'
cpu = 'arm64'
endian = 'little'

[properties]
c_args = ['-arch', 'arm64', '-isysroot', '__SDKROOT__', '-mvisionos-version-min=2.0']
cpp_args = ['-arch', 'arm64', '-isysroot', '__SDKROOT__', '-mvisionos-version-min=2.0']
c_link_args = ['-arch', 'arm64', '-isysroot', '__SDKROOT__', '-mvisionos-version-min=2.0']
cpp_link_args = ['-arch', 'arm64', '-isysroot', '__SDKROOT__', '-mvisionos-version-min=2.0']
