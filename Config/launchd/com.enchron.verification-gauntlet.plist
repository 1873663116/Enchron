<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.enchron.verification-gauntlet</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/Cortisol/DevSpace/EnchronWorkspace/Enchron/Scripts/verification/run_verification_gauntlet.py</string>
        <string>--log-root</string>
        <string>/Volumes/Cortisol/DevSpace/Xcode/Enchron/VerificationGauntlet/runs</string>
        <string>--retain-runs</string>
        <string>14</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/Cortisol/DevSpace/EnchronWorkspace/Enchron</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Volumes/Cortisol/DevSpace/Xcode/Enchron/VerificationGauntlet/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/Cortisol/DevSpace/Xcode/Enchron/VerificationGauntlet/launchd.stderr.log</string>
    <key>ThrottleInterval</key>
    <integer>3600</integer>
</dict>
</plist>
