<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Enchron needs access to your photo library to browse and play videos.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Enchron connects to media servers on your local network to browse and stream videos.</string>
	<key>NSWorldSensingUsageDescription</key>
	<string>Enchron uses world sensing to place the cinema environment and screen around you.</string>
	<key>NSHandsTrackingUsageDescription</key>
	<string>Enchron uses hand tracking for spatial playback controls in immersive environments.</string>
	<key>NSAccessoryTrackingUsageDescription</key>
	<string>Enchron uses accessory tracking to support spatial interaction in immersive environments.</string>
	<key>NSCameraUsageDescription</key>
	<string>Enchron uses the camera for spatial scene understanding while presenting immersive environments.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
</dict>
</plist>
