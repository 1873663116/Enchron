      "defect": {
        "type": "replace-text",
        "file": "Modules/Playback/Platform/SpatialPlatformEffectExecutor.swift",
        "find": "guard await waitUntilWindowIsPresented(",
        "replaceWith": "guard await windowIsPresentedWithoutWaiting("
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
