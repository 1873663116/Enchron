        "find": "        guard let identifier = windowSceneSessionIdentifier(for: window) else {\n            return windowObservation.residency(for: window) == .closed\n        }\n",
        "replaceWith": "        if windowObservation.residency(for: window) == .closed { return true }\n        guard let identifier = windowSceneSessionIdentifier(for: window) else { return false }\n"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
