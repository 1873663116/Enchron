{
  "version": 1,
  "checks": [
    {
      "id": "package-membership-rejects-missing-production-input",
      "guard": "Scripts/rules/verify_package_membership.py",
      "defect": {
        "type": "remove-xcfilelist-entry",
        "entry": "$(SRCROOT)/Apps/Enchron/AppModel.swift"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "missing $(SRCROOT)/Apps/Enchron/AppModel.swift"
        ]
      }
    },
    {
      "id": "playback-structure-rejects-unbaselined-gap",
      "guard": "Scripts/rules/verify_playback_surface_structure.py",
      "defect": {
        "type": "remove-playback-gap-baseline-entry",
        "name": "window camera is missing"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "window camera is missing"
        ]
      }
    },
    {
      "id": "playback-issue-ownership-rejects-second-writer",
      "guard": "Scripts/rules/verify_playback_issue_ownership.py",
      "defect": {
        "type": "add-playback-issue-write"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "IllegalPlaybackIssueWriter.swift:2",
          "playback-issue-write-outside-owner"
        ]
      }
    },
    {
      "id": "media-byte-stream-foundation-rejects-missing-range-protocol",
      "guard": "Scripts/rules/verify_media_byte_stream_foundation.py",
      "defect": {
        "type": "replace-text",
        "file": "Modules/MediaSource/MediaByteStream.swift",
        "find": "public protocol MediaByteRangeSource",
        "replaceWith": "public protocol RenamedAwayByTheSelfTest"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "byte-range source protocol is missing"
        ]
      }
    },
    {
      "id": "media-byte-stream-rejects-missing-app-singleton",
      "guard": "Scripts/rules/verify_media_byte_stream.py",
      "defect": {
        "type": "replace-text",
        "file": "Modules/MediaSource/MediaByteStream.swift",
        "find": "static let shared = MediaByteStreamServer()",
        "replaceWith": "static let instance = MediaByteStreamServer()"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "M2: App singleton is missing"
        ]
      }
    },
    {
      "id": "demux-buffer-policy-rejects-drifted-cache-defaults",
      "guard": "Scripts/rules/verify_demux_buffer_policy.py",
      "defect": {
        "type": "replace-text",
        "file": "Packages/PlaybackCore/Sources/PlaybackFFmpegBridge/PlaybackFFmpegBridge.c",
        "find": "150LL * 1024 * 1024",
        "replaceWith": "200LL * 1024 * 1024"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "mpv demux_conf byte and cache-duration defaults drifted"
        ]
      }
    },
    {
      "id": "core-regression-plan-rejects-a-test-that-does-not-exist",
      "guard": "Scripts/rules/verify_visionpro_core_regression_plan.py",
      "defect": {
        "type": "replace-text",
        "file": "VisionProCoreRegression.xctestplan",
        "find": "SmokeLaunchUITests/testAppLaunchesToInteractiveMainWindow()",
        "replaceWith": "SmokeLaunchUITests/testThisMethodWasDeleted()"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "selected tests without XCTest declarations"
        ]
      }
    },
    {
      "id": "format-description-ownership-rejects-a-second-exported-declaration",
      "guard": "Scripts/rules/verify_format_description_ownership.py",
      "defect": {
        "type": "replace-text",
        "file": "Packages/PlaybackCore/Sources/PlaybackFFmpegBridge/include/PlaybackFFmpegBridge.h",
        "find": "OSStatus PBFFmpegVideoFormatDescriptionCreate(",
        "replaceWith": "OSStatus PBFFmpegVideoFormatDescriptionCreate(void);\nOSStatus PBFFmpegVideoFormatDescriptionCreate(",
        "introduces": "OSStatus PBFFmpegVideoFormatDescriptionCreate(void);"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "must have exactly one exported declaration"
        ]
      }
    },
    {
      "id": "glass-usage-rejects-raw-glass-outside-its-owner",
      "guard": "Scripts/rules/verify_glass_usage.py",
      "defect": {
        "type": "replace-text",
        "file": "Modules/Playback/Views/PlaybackPanel.swift",
        "find": ".enchronGlassBackground(in: shape)",
        "replaceWith": ".glassBackgroundEffect()",
        "introduces": ".glassBackgroundEffect()"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "raw-glass-outside-owner"
        ]
      }
    },
    {
      "id": "scripts-inventory-rejects-a-missing-structure-check-table",
      "guard": "Scripts/rules/verify_scripts_inventory.py",
      "defect": {
        "type": "replace-text",
        "file": "Scripts/rules/run_verification.py",
        "find": "STRUCTURE_CHECKS = (",
        "replaceWith": "STRUCTURE_CHECK_TABLE = ("
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "no STRUCTURE_CHECKS table"
        ]
      }
    },
    {
      "id": "swiftlint-rejects-a-force-unwrap-outside-the-baseline",
      "guard": "Scripts/rules/verify_swiftlint.py",
      "defect": {
        "type": "replace-text",
        "file": "Modules/DesignSystem/View+Platform.swift",
        "find": "import SwiftUI",
        "replaceWith": "import SwiftUI\n\nprivate let guardSelfTestForcedUnwrap = Optional(1)!",
        "introduces": "private let guardSelfTestForcedUnwrap = Optional(1)!"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "outside the baseline"
        ]
      }
    },
    {
      "id": "hover-region-clipping-rejects-a-hit-target-larger-than-its-hover-shape",
      "guard": "Scripts/rules/check_hover_region_clipping.py",
      "defect": {
        "type": "replace-text",
        "file": "Modules/DesignSystem/Components/SettingsComponents.swift",
        "find": ".frame(width: cardWidth)",
        "replaceWith": ".frame(width: DesignTokens.Interactive.large)",
        "occurrences": 2,
        "introduces": ".frame(width: DesignTokens.Interactive.large)"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "Confirmed violations: 1",
          "enlarged interaction target without a post-expansion inset hover shape"
        ]
      }
    },
    {
      "id": "playback-surface-structure-rejects-a-non-singleton-media-library-window",
      "guard": "Scripts/rules/verify_playback_surface_structure.py",
      "defect": {
        "type": "replace-text",
        "file": "Apps/Enchron/EnchronApp.swift",
        "find": "        Window(\n            \"Enchron\",\n            id: \"main\"\n        ) {",
        "replaceWith": "        WindowGroup(\n            \"Enchron\",\n            id: \"main\"\n        ) {"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "Media Library is not a singleton Window Scene"
        ]
      }
    },
    {
      "id": "playback-surface-structure-rejects-a-handover-that-does-not-wait",
      "guard": "Scripts/rules/verify_playback_surface_structure.py",
      "defect": {
        "type": "replace-text",
        "file": "Modules/Playback/Platform/SpatialPlatformEffectExecutor.swift",
        "find": "while windowObservation.residency(for: handover.incoming) != .open {",
        "replaceWith": "while false {"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "dismisses the outgoing window without first observing the incoming one open"
        ]
      }
    }
  ],
