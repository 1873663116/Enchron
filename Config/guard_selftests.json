        "find": "        actions.openWindow(id: handover.incoming.rawValue)\n",
        "replaceWith": "        actions.pushWindow(id: handover.incoming.rawValue)\n"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "the playback window handover dismisses the outgoing window without"
