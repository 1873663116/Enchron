{
  "version": 1,
  "checks": [
    {
      "id": "package-membership-rejects-missing-production-input",
      "guard": "Scripts/verification/verify_package_membership.py",
      "defect": {
        "type": "remove-xcfilelist-entry",
        "entry": "$(SRCROOT)/Apps/Enchron/AppModel.swift"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "missing $(SRCROOT)/Apps/Enchron/AppModel.swift"
        ]
      }
    },
    {
      "id": "package-membership-rejects-design-preview-app-layer-reference",
      "guard": "Scripts/verification/verify_package_membership.py",
      "defect": {
        "type": "add-app-layer-reference",
        "entry": "PlaybackPresentation/Views/PlaybackTopActions.swift"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "Modules sources in DesignPreview that reference Apps/Enchron types:",
          "Modules/PlaybackPresentation/Views/PlaybackTopActions.swift: AppModel"
        ]
      }
    },
    {
      "id": "playback-structure-rejects-unbaselined-gap",
      "guard": "Scripts/verification/verify_playback_surface_structure.py",
      "defect": {
        "type": "remove-playback-gap-baseline-entry",
        "name": "window camera is missing"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "window camera is missing"
        ]
      }
    },
    {
      "id": "playback-issue-ownership-rejects-second-writer",
      "guard": "Scripts/verification/verify_playback_issue_ownership.py",
      "defect": {
        "type": "add-playback-issue-write"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "IllegalPlaybackIssueWriter.swift:2",
          "playback-issue-write-outside-owner"
        ]
      }
    }
  ]
}
