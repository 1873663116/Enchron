        "find": "import SwiftUI",
        "replaceWith": "import SwiftUI\n\nprivate let guardSelfTestForcedUnwrap = Optional(1)!",
        "introduces": "private let guardSelfTestForcedUnwrap = Optional(1)!"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "outside the baseline"
        ]
      }
    },
    {
      "id": "hover-region-clipping-rejects-a-hit-target-larger-than-its-hover-shape",
      "guard": "Scripts/rules/check_hover_region_clipping.py",
      "defect": {
        "type": "replace-text",
        "file": "Modules/DesignSystem/Components/SettingsComponents.swift",
        "find": ".frame(width: cardWidth)",
        "replaceWith": ".frame(width: DesignTokens.Interactive.large)",
        "occurrences": 2,
        "introduces": ".frame(width: DesignTokens.Interactive.large)"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "Confirmed violations: 1",
          "enlarged interaction target without a post-expansion inset hover shape"
        ]
      }
    },
    {
      "id": "regression-core-layering-rejects-verification-import",
      "guard": "Scripts/rules/verify_regression_core_layering.py",
      "defect": {
        "type": "replace-text",
        "file": "Scripts/regression/core/errors.py",
        "find": "from __future__ import annotations\n\n",
        "replaceWith": "from __future__ import annotations\n\nimport Scripts.verification\n\n",
        "introduces": "import Scripts.verification"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "core/errors.py:3",
          "[forbidden-core-import]"
        ]
      }
    },
    {
      "id": "product-source-comments-rejects-line-comment",
      "guard": "Scripts/rules/verify_product_source_comments.py",
      "defect": {
        "type": "replace-text",
        "file": "Modules/DesignSystem/View+Platform.swift",
        "find": "import SwiftUI\n\n",
        "replaceWith": "import SwiftUI\n\n// forbidden guard self-test comment\n",
        "introduces": "// forbidden guard self-test comment"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "Modules/DesignSystem/View+Platform.swift:3:1",
          "source comment // is forbidden"
        ]
      }
    },
    {
      "id": "product-source-comments-rejects-python-comment",
      "guard": "Scripts/rules/verify_product_source_comments.py",
      "defect": {
        "type": "replace-text",
        "file": "Scripts/rules/verify_glass_usage.py",
        "find": "from __future__ import annotations\n\n",
        "replaceWith": "from __future__ import annotations\n\n# forbidden guard self-test comment\n",
        "introduces": "# forbidden guard self-test comment"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "Scripts/rules/verify_glass_usage.py:5:1",
          "source comment # is forbidden"
        ]
      }
    },
    {
      "id": "reachability-cell-access-rejects-an-unguarded-lookup",
      "guard": "Scripts/rules/verify_reachability_cell_access.py",
      "defect": {
        "type": "replace-text",
        "file": "Scripts/verification/reachability_matrix.py",
        "find": "        if not self.provable(presentation, parent_operation_id):\n            return False\n        parent = self.cells[(presentation, parent_operation_id)]",
        "replaceWith": "        parent = self.cells[(presentation, parent_operation_id)]  # unguarded",
        "introduces": "self.cells[(presentation, parent_operation_id)]  # unguarded"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "reads self.cells without asking provable() first"
        ]
      }
    },
    {
      "id": "playback-surface-structure-rejects-a-non-singleton-media-library-window",
      "guard": "Scripts/rules/verify_playback_surface_structure.py",
      "defect": {
        "type": "replace-text",
        "file": "Apps/Enchron/EnchronApp.swift",
        "find": "        Window(\n            \"Enchron\",\n            id: \"main\"\n        ) {",
        "replaceWith": "        WindowGroup(\n            \"Enchron\",\n            id: \"main\"\n        ) {"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "Media Library is not a singleton Window Scene"
        ]
      }
    },
    {
      "id": "playback-surface-structure-rejects-a-handover-that-does-not-wait",
