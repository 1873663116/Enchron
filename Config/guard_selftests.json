        "type": "replace-text",
        "file": "Config/Enchron-Info.plist",
        "find": "<key>NSAllowsArbitraryLoads</key>",
        "replaceWith": "<key>NSAllowsLocalNetworking</key>"
      },
      "expected": {
        "exitCode": 1,
        "outputContains": [
          "NSAllowsLocalNetworking makes the system ignore NSAllowsArbitraryLoads and substitute NO"
        ]
      }
    },
    {
