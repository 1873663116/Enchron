# Finder metadata
.DS_Store

# Local agent/tooling
.context/
.omc/
.omc_inner_repo/
.codex-crashlogs/
.codex-debug-runs/
.xcodebuildmcp/
.cursor/debug-*.log
__pycache__/

# SwiftPM local workspace state
.build/
.swiftpm/
**/.swiftpm/

# Session scratch: probes, DerivedData, logs (see AGENTS.md 构建产物)
.scratch/

# Xcode local build output
/build/
**/xcuserdata/

# Local validation output
test-results/

# Overnight runtime artifacts
morning-report.md
overnight-log.md
TODOS.md
.overnight-supervisor/
logs/

# RCP immersive scene binary (~42MB) — local-only per ADR-0008, not committed
Modules/Playback/Resources/Immersive_Space.reality

# Plaintext device-test credentials, local-only
.env
# Emby test credentials — local only, filled by the maintainer
*.local.json

# Device evidence: recordings, result bundles, frame dumps. Not regenerable
# without the headset, so it outlives .scratch, but far too large to commit.
# Tiers are defined in AGENTS.md.
TestEvidence/

# Coordinator ledger: watches, dispatch records, drained messages.
# Agents write these beside whatever directory they are working in, so the
# patterns match at any depth rather than only at the repository root.
**/.claude/state/
**/.claude/hooks-off
**/.claude/loop-off
