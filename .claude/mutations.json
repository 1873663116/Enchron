      "find": "    command = executable_text(text)",
      "replaceWith": "    command = text",
      "probe": "gate",
      "expect": [
        "lane-heredoc-quoting-a-banned-word",
        "lane-heredoc-then-ordinary-work"
      ]
    },
    {
      "id": "gate-heredoc-swallows-everything",
      "file": "hooks/orca_channel_gate.py",
