  "mutations": [
    {
      "id": "gate-detach",
      "file": "hooks/orca_channel_gate.py",
      "find": "DETACHERS = re.compile(r\"(?<![\\w-])(?:nohup|setsid|disown)(?![\\w-])\")",
      "replaceWith": "DETACHERS = re.compile(r\"(?!x)x\")",
      "probe": "gate",
      "expect": [
        "detach-nohup",
        "detach-setsid",
        "detach-disown"
      ]
    },
    {
      "id": "gate-heredoc-not-stripped",
