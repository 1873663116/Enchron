{
  "version": 1,
  "probes": {
    "gate": "hooks/test_orca_channel_gate.py",
    "stop": "hooks/test_loop_wakeup_gate.py",
    "channel": "tools/test_orca_channel.py",
    "catalog": "hooks/test_catalog_write_gate.py"
